# Databases
*.db
*.sqlite3

# Stored ebook files. Anchored, because a bare `library/` matches any directory
# with that name at any depth — it once silently swallowed the old Flutter
# client's `lib/library/` source folder, which was a feature, not a book
# store. The hazard is not Flutter's; keep the anchor for the next client.
/library/
/backend/library/

# Built by scripts/run.sh: the client copied into the package, the wheel, and
# the throwaway venv plus its data. All reproducible, none of it source.
/backend/app/web/
/backend/dist/
/.run/

# Env
.env

# Claude Code — per-machine permission grants; shared settings.json stays tracked
.claude/settings.local.json
.claude.local.md

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
