# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ruff_cache/
.pytest_cache/

# Databases
*.db
*.sqlite3

# Stored ebook files. Anchored, because a bare `library/` matches any directory
# with that name at any depth — it was silently swallowing the client's
# `lib/library/` source folder, which is a feature, not a book store.
/library/
/backend/library/

# Built by scripts/run.sh: the client copied into the package, the wheel, and
# the throwaway venv plus its data. All reproducible, none of it source.
/backend/app/web/
/backend/dist/
/.run/

# Env
.env

# Flutter / Dart
client/.dart_tool/
client/.flutter-plugins
client/.flutter-plugins-dependencies
client/build/
client/.packages

# Claude Code — per-machine permission grants; shared settings.json stays tracked
.claude/settings.local.json
.claude.local.md

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
