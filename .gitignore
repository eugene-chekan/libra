# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ruff_cache/
.pytest_cache/

# Databases
*.db
*.sqlite3

# Stored ebook files. Anchored, because a bare `library/` matches any directory
# with that name at any depth, including one that is source code rather than
# a book store.
/library/
/backend/library/

# Built by scripts/run.sh: the client copied into the package, the wheel, and
# the throwaway venv plus its data. All reproducible, none of it source.
/backend/app/web/
/backend/dist/
/.run/

# The scratch backend CI starts for web/e2e/auth.spec.ts.
/backend/e2e-scratch/

# Env
.env

# The web client. node_modules and dist are reproducible from package-lock.json
# and the source; package-lock.json itself is tracked, because `npm ci` needs it
# and because a build that resolves different versions than the last one is not
# the same build.
/web/node_modules/
/web/dist/
/web/playwright-report/
/web/test-results/
# The signed-in cookie the auth setup project saves for every other e2e spec
# to reuse. A session, even a scratch one, does not belong in the repo.
/web/e2e/.auth/

# Claude Code — per-machine permission grants; shared settings.json stays tracked
.claude/settings.local.json
.claude.local.md

# Superpowers plugin scratch: SDD ledgers, brainstorming mockups. Working
# artifacts, not source.
/.superpowers/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
