@startuml context
' Context diagram: the new search module inside the existing Libra
' application, its users and the external systems.
' Render: paste into https://www.plantuml.com/plantuml or use the
' PlantUML extension in VS Code, then save as context.png here.
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial

actor "Reader" as reader
actor "Household\nadministrator" as admin
actor "Researcher" as researcher

rectangle "Libra (existing web application)" {
  rectangle "Librarian panel\n(new: shows passages)" as panel
  rectangle "Search module (new)\nchunks, BM25, embeddings,\ndescriptors, RRF" as search
  database "SQLite\nbooks + chunks,\nFTS5, vectors" as db
  rectangle "Catalogue, reader,\nshelves, Kindle\n(existing, unchanged)" as existing
}

cloud "LLM API\n(descriptors)" as llm
database "Standard Ebooks\n(40 test books, CC0)" as se

reader --> panel : question
panel --> search : search(question)
search --> db
panel --> existing : open passage in the reader
admin --> search : rag index / rag describe
researcher --> search : rag evaluate / rag report
search --> llm : chunk text, question
llm --> search : descriptors (JSON)
se ..> existing : EPUB files, loaded once
@enduml
